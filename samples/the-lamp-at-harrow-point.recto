                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": "center"
              },
              "content": [
                {
                  "type": "text",
                  "text": "A Short History of Wicks",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": "center"
              },
              "content": [
                {
                  "type": "text",
                  "text": "Gulls, Counted",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "updatedAt": 1767225600000
