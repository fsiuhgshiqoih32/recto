{
  "name": "recto",
  "productName": "Recto",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source book formatter: manuscript in, EPUB and print-ready PDF out.",
  "author": "Recto contributors",
  "license": "MIT",
  "homepage": "https://github.com/fsiuhgshiqoih32/recto",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsiuhgshiqoih32/recto.git"
  },
  "bugs": {
    "url": "https://github.com/fsiuhgshiqoih32/recto/issues"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "predev": "npm run fonts",
    "dev": "vite",
    "prebuild": "npm run fonts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pdf": "tsx scripts/check-pdf.ts",
    "test:epub": "tsx scripts/check-epub.ts",
    "test:e2e": "playwright test",
    "pdf": "tsx cli/pdf.ts",
    "epub": "tsx cli/epub.ts",
    "sample:docx": "tsx scripts/make-sample-docx.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "dist:win": "npm run build && npm run desktop:build && electron-builder --win --publish never",
    "dist": "npm run build && npm run desktop:build && electron-builder --publish never",
    "test:desktop": "npm run build && npm run desktop:build && playwright test --config playwright.desktop.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/crimson-pro": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-serif-devanagari": "5.3.0",
    "@fontsource/noto-serif-hebrew": "5.3.0",
    "@fontsource/noto-serif-thai": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@likecoin/epubcheck-ts": "0.7.0",
    "@pdfme/pdf-lib": "6.1.13",
    "@playwright/test": "1.64.0",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/extension-text-align": "2.27.3",
    "@tiptap/html": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@types/css-tree": "3.2.0",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "css-tree": "3.2.1",
    "dexie": "4.4.6",
    "docx": "9.7.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fast-xml-parser": "4.5.7",
    "happy-dom": "17.6.3",
    "hyphen": "1.14.1",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "markdown-it": "14.3.2",
    "markdown-it-footnote": "4.0.0",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
